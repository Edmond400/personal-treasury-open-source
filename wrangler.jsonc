{
  "name": "personal-treasury",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-treasury-db",
      "database_id": "00000000-0000-4000-8000-000000000003",
      "migrations_dir": "migrations"
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": false
  }
}
